# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# ONLY the public "anon" / "publishable" key belongs here. It is safe to ship
# to the browser because Row Level Security restricts every query to the
# signed-in user. NEVER put the service_role / secret key in any VITE_* var:
# everything prefixed with VITE_ is bundled into the public JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
